<launch>
    <param name="/use_sim_time" value="true" />

    <!-- Start Gazebo with our custom world -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find multi_robot_sim)/worlds/basic_arena.world"/>
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>

    <!-- Spawn Robot 1 since we doing multirobot-->
    <include file="$(find multi_robot_sim)/launch/spawn_one_robot.launch">
        <arg name="robot_name" value="robot_alpha" />
        <arg name="x_pos" value="-1.0" />
        <arg name="y_pos" value="0.0" />
    </include>

    <!-- Spawn Robot 2 -->
    <include file="$(find multi_robot_sim)/launch/spawn_one_robot.launch">
        <arg name="robot_name" value="robot_beta" />
        <arg name="x_pos" value="1.0" />
        <arg name="y_pos" value="0.0" />
        <arg name="yaw"   value="3.14159" />
    </include>

    <!-- Add more robots here if needed by copying the include block :D
    <include file="$(find multi_robot_sim)/launch/spawn_one_robot.launch">
        <arg name="robot_name" value="robot_gamma" />
        <arg name="x_pos" value="0.0" />
        <arg name="y_pos" value="1.0" />
        <arg name="yaw"   value="1.57" />
    </include>
    -->
</launch>