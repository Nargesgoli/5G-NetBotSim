<launch>
    <arg name="robot_name" default="robot_default"/>
    <arg name="x_pos" default="0.0"/>
    <arg name="y_pos" default="0.0"/>
    <arg name="z_pos" default="0.1"/>
    <arg name="yaw" default="0.0"/>

    <!-- Load URDF to parameter server, passing the robot_namespace for the Gazebo plugin -->
    <param name="$(arg robot_name)/robot_description"
           command="$(find xacro)/xacro '$(find multi_robot_sim)/urdf/custom_diff_drive.urdf.xacro' robot_namespace:=$(arg robot_name)" />

    <!-- Spawn robot in Gazebo -->
    <node name="spawn_urdf_$(arg robot_name)" pkg="gazebo_ros" type="spawn_model"
          args="-urdf -model $(arg robot_name) -param $(arg robot_name)/robot_description
                -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -Y $(arg yaw)"
          respawn="false" output="screen" />

    <!-- Start robot_state_publisher for this robot's TF -->
    <group ns="$(arg robot_name)">
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
            <param name="publish_frequency" type="double" value="50.0" />
            <param name="tf_prefix" value="$(arg robot_name)" />
        </node>
    </group>
</launch>