#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
role="${1:---help}"
if [[ "$role" == --help || "$role" == help ]]; then
  printf '%s\n' 'Usage: scripts/run-app ROLE [arguments]' \
    'Host: commander ros-bridge leader follower plot latency-sender' \
    'Drone host: drone-leader-state drone-follower drone-flight drone-plot' \
    'Drone container: drone-ue1-injector drone-ue2-receiver' \
    'Container: ran-bridge ue-receiver ue1-injector ue2-receiver latency-bridge' \
    'UE namespace: latency-ue1 latency-ue2 (run with ip netns exec)' \
    'See docs/DRONE_EXPERIMENT.md and docs/GROUND_EXPERIMENT.md for prerequisites and startup order.'
  exit 0
fi
shift
case "$role" in
 drone-leader-state) file=BotSim/drone_network/leader_state.py ;;
 drone-follower) file=BotSim/drone_network/follower_control.py ;;
 drone-ue1-injector) file=BotSim/drone_network/ue1_injector.py ;;
 drone-ue2-receiver) file=BotSim/drone_network/ue2_receiver.py ;;
 drone-flight) file=BotSim/workspaces/quadrotor_ws/src/simple_multi_sim/scripts/leader_driver.py ;;
 drone-plot) file=experiments/plot_drone_network.py ;;
 commander) file=BotSim/teleoperation/commander.py ;;
 ran-bridge) file=BotSim/teleoperation/ran_bridge.py ;;
 ue-receiver) file=BotSim/teleoperation/ue_receiver.py ;;
 ros-bridge) file=BotSim/teleoperation/ros_bridge.py ;;
 leader) file=BotSim/leader_follower/leader.py ;;
 follower) file=BotSim/leader_follower/follower.py ;;
 ue1-injector) file=BotSim/leader_follower/ue1_injector.py ;;
 ue2-receiver) file=BotSim/leader_follower/ue2_receiver.py ;;
 plot) file=experiments/plot_platooning.py ;;
 latency-sender) file=experiments/latency/command_sender.py ;;
 latency-bridge) file=experiments/latency/ran_bridge.py ;;
 latency-ue1) file=experiments/latency/ue1_receiver.py ;;
 latency-ue2) file=experiments/latency/ue2_receiver.py ;;
 *) printf 'Unknown application role: %s\n' "$role" >&2; exit 2 ;;
esac
# All generated logs stay outside the source folders.
results_dir="${NETBOTSIM_RESULTS_DIR:-$project_root/results}"
mkdir -p "$results_dir"
export NETBOTSIM_RESULTS_DIR="$results_dir"
cd "$results_dir"
exec python3 "$project_root/$file" "$@"
