#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
action="${1:---help}"
if [[ "$action" == --help || "$action" == help ]]; then
  printf '%s\n' 'Usage: scripts/ros-workspace {build-ground|build-quadrotor|ground|ground-follow|quadrotor}'
  exit 0
fi
case "$action" in
 build-ground|ground|ground-follow) workspace="$project_root/BotSim/workspaces/ground_ws" ;;
 build-quadrotor|quadrotor) workspace="$project_root/BotSim/workspaces/quadrotor_ws" ;;
 *) printf 'Unknown ROS action: %s\n' "$action" >&2; exit 2 ;;
esac
shift
ros_setup="${NETBOTSIM_ROS_SETUP:-/opt/ros/noetic/setup.bash}"
[[ -f "$ros_setup" ]] || { printf 'ROS environment not found: %s\n' "$ros_setup" >&2; exit 1; }
set +u
source "$ros_setup"
set -u
case "$action" in
 build-*)
  command -v catkin_init_workspace >/dev/null || { printf 'catkin_init_workspace unavailable.\n' >&2; exit 1; }
  command -v catkin_make >/dev/null || { printf 'catkin_make unavailable.\n' >&2; exit 1; }
  if [[ ! -e "$workspace/src/CMakeLists.txt" ]]; then catkin_init_workspace "$workspace/src"; fi
  exec catkin_make -C "$workspace" -j"${NETBOTSIM_JOBS:-4}" "$@" ;;
esac
[[ -f "$workspace/devel/setup.bash" ]] || { printf 'Build this workspace before launching: %s\n' "$workspace" >&2; exit 1; }
set +u
source "$workspace/devel/setup.bash"
set -u
case "$action" in
 ground) exec roslaunch multi_robot_sim start_multi_robot_sim.launch "$@" ;;
 ground-follow) exec roslaunch multi_robot_sim leader_follower.launch "$@" ;;
 quadrotor) exec roslaunch simple_multi_sim start_multi_robot_sim.launch "$@" ;;
esac
