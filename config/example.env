# Source this file on the HOST before launching scripts.
# With --network host, loopback reaches the host from the container.
export NETBOTSIM_HOST_IP=127.0.0.1
export NETBOTSIM_CONTAINER=netbotsim_0
# Set this to your actual ROS catkin workspace:
# export NETBOTSIM_ROS_WS=/absolute/path/to/catkin_ws
